{
  "channels": {
    "whatsapp": {"max_chars": 900, "requires_opt_in": "whatsapp_opt_in", "requires_opt_out_text": true},
    "sms": {"max_chars": 320, "requires_opt_in": "sms_opt_in", "requires_opt_out_text": true, "blocked_by_dnd": true},
    "email": {"max_chars": 2500, "requires_opt_in": "email_opt_in", "requires_opt_out_text": true}
  },
  "banned_phrases": [
    "guaranteed approval", "100% approval", "guaranteed", "no documents", "no credit check",
    "zero risk", "risk-free", "act now or lose", "last chance", "lowest rate in india",
    "free money", "no questions asked"
  ],
  "required_disclaimers": {
    "lending": "T&C apply. Subject to credit approval.",
    "cards": "T&C apply. Subject to credit approval.",
    "deposits": "T&C apply.",
    "investments": "Mutual fund investments are subject to market risks, read all scheme related documents carefully."
  },
  "opt_out_text": {
    "whatsapp": "Reply STOP to opt out.",
    "sms": "Reply STOP to opt out.",
    "email": "To unsubscribe from marketing emails, reply UNSUBSCRIBE."
  },
  "pii_patterns": {
    "account_number": "\\b\\d{9,18}\\b",
    "pan": "\\b[A-Z]{5}[0-9]{4}[A-Z]\\b",
    "rupee_amount_spent": "(?i)you (spent|paid|transferred) (rs\\.?|inr|₹)"
  }
}
